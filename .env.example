# Copy to .env.local (gitignored) and fill in. Keys can also be saved in the app's Settings page.
NAIVE_API_KEY=
MONID_API_KEY=
MOBILERUN_API_KEY=

# Optional: point at a specific ffmpeg binary (otherwise the system one or ffmpeg-static is used).
# FFMPEG_PATH=/usr/bin/ffmpeg

# Optional: run the core on Convex, as the Vercel deployment does (docs/convex.md).
# CONVEX_DEPLOY_KEY=
# NEXT_PUBLIC_CONVEX_URL=
# NOMEN_SERVER_SECRET=

# Optional: a password gate on a hosted copy, or force demo-only mode.
# SITE_PASSWORD=
# NOMEN_DEMO_ONLY=1
